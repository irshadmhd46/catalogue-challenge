# Copy to .env for local use. Only this example file is committed.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=10000
BODY_LIMIT_BYTES=10240
SHUTDOWN_TIMEOUT_MS=10000

# Catalogue source (the Fake Store demo API). Must be https when NODE_ENV=production.
CATALOG_DRIVER=fakestore
FAKESTORE_BASE_URL=https://fakestoreapi.com
UPSTREAM_TIMEOUT_MS=4000
UPSTREAM_MAX_RETRIES=1

# In-memory cache (per process). A shared cache such as Redis is a next step, see DECISIONS.md.
CACHE_FRESH_TTL_SECONDS=60
CACHE_STALE_TTL_SECONDS=3600

# Optional: comma-separated product ids to feature instead of the top rated (max 10).
# FEATURED_PRODUCT_IDS=1,2,3

# Enquiry email. Defaults point at a local Mailpit (the compose stack runs it; inbox UI on :8025).
# In production SMTP_HOST, SMTP_PORT, SMTP_TLS (starttls or tls), MAIL_FROM and SALES_INBOX are required.
NOTIFIER_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=none
# SMTP_USER and SMTP_PASSWORD are set together or not at all; never commit real values.
# SMTP_USER=
# SMTP_PASSWORD=
SMTP_TIMEOUT_MS=8000
MAIL_FROM=no-reply@catalogue.local
SALES_INBOX=sales@catalogue.local

# Rate limits per client address per minute, and how many proxy hops to trust for the client address.
# Behind the local proxy or an AWS load balancer use TRUST_PROXY_HOPS=1; with a direct connection 0.
RATE_LIMIT_ENQUIRY_PER_MINUTE=5
RATE_LIMIT_READ_PER_MINUTE=120
TRUST_PROXY_HOPS=0
